# Copy this file to `.env` and edit as needed.
# Everything here is OPTIONAL — sensible defaults are used if omitted.
# This file is safe to commit; `.env` is git-ignored.

# Your FPL manager/entry id (the number in your FPL "Points" page URL).
# Needed to load YOUR squad, captain and picks.
FPL_TEAM_ID=

# How many top overall managers to sample for the "template" / effective ownership.
TOP_MANAGERS_SAMPLE=50

# How many days of news to consider "recent".
NEWS_RECENCY_DAYS=10

# Insights provider: "null" (no AI, rule-based only) or "claude".
INSIGHTS_PROVIDER=null

# Claude integration mode when INSIGHTS_PROVIDER=claude:
#   bundle -> app writes a briefing file for you to run through Claude, then you drop the JSON back in exports/
#   cli    -> app calls the `claude` CLI non-interactively on this machine (Claude Code must be installed + logged in)
CLAUDE_MODE=bundle
CLAUDE_CLI_PATH=claude

# Storage locations (defaults shown). Relative paths are resolved from the project root.
# DATA_DIR=./data
# DB_PATH=./data/fpl.sqlite
# BRIEFINGS_DIR=./briefings
# EXPORTS_DIR=./exports
# SOURCES_PATH=./config/sources.yaml
