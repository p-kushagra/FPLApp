Thumbs.db

# Claude local state. The skills and agents under .claude/ that are already
# tracked stay tracked (gitignore never untracks); this only stops NEW local
# files (settings.local.json, transient session state) from being committed.
.claude/

# Insight bundles / exports (may contain scraped article text)
briefings/
exports/

# Refresh logs
logs/
